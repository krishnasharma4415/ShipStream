# Production Environment Variables Template
# Copy this to your deployment platform (Render.com, Vercel, etc.)

# ============================================
# BACKEND SERVICES (Render.com)
# ============================================

# Service Ports (Render auto-assigns PORT, but these are for reference)
AUTH_SERVICE_PORT=5501
UPLOAD_SERVICE_PORT=5500
DEPLOY_SERVICE_PORT=5502
REQUEST_HANDLER_PORT=3000

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://your-auth-service.onrender.com/auth/github/callback

# Security Keys (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
JWT_SECRET=your_production_jwt_secret_key
ENCRYPTION_KEY=your_production_encryption_key

# Service URLs (Update with your actual Render.com URLs)
AUTH_SERVICE_URL=https://your-auth-service.onrender.com
UPLOAD_SERVICE_URL=https://your-upload-service.onrender.com
DEPLOY_SERVICE_URL=https://your-deploy-service.onrender.com
FRONTEND_URL=https://your-app.vercel.app

# Cloudflare R2 Configuration
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name

# Upstash Redis Configuration
REDIS_URL=rediss://default:your_upstash_token@your-endpoint.upstash.io:6379

# Environment
NODE_ENV=production

# ============================================
# FRONTEND (Vercel)
# ============================================

VITE_AUTH_SERVICE_URL=https://your-auth-service.onrender.com
VITE_UPLOAD_SERVICE_URL=https://your-upload-service.onrender.com
VITE_DEPLOY_SERVICE_URL=https://your-deploy-service.onrender.com
VITE_FRONTEND_URL=https://your-app.vercel.app
